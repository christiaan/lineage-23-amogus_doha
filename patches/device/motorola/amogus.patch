diff --git a/Android.mk b/Android.mk
index 1a6f520..7ff828b 100644
--- a/Android.mk
+++ b/Android.mk
@@ -4,10 +4,12 @@ LOCAL_PATH := $(call my-dir)
 
 include $(call all-subdir-makefiles)
 
+ifneq ($(PRODUCT_VENDOR_KERNEL_HEADERS),)
 $(TARGET_OUT_INTERMEDIATES)/KERNEL_OBJ/usr: $(wildcard $(PRODUCT_VENDOR_KERNEL_HEADERS)/*)
 	rm -rf $@
 	mkdir -p $@/include
 	cp -a $(PRODUCT_VENDOR_KERNEL_HEADERS)/. $@/include
+endif
 
 include $(CLEAR_VARS)
 LOCAL_MODULE := amogus_folders
diff --git a/BoardConfig.mk b/BoardConfig.mk
index d7cdd2b..817fca4 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -27,10 +27,14 @@ TARGET_2ND_CPU_VARIANT_RUNTIME := cortex-a53
 
 # Kernel
 BOARD_KERNEL_CMDLINE += androidboot.usbcontroller=4e00000.dwc3
+# Android 17 first-stage init only links /dev/block/by-name/* for the boot
+# device, and the bootloader passes only the legacy androidboot.bootdevice.
+BOARD_KERNEL_CMDLINE += androidboot.boot_devices=soc/4744000.sdhci
 
 # SELinux
 BOARD_USE_ENFORCING_SELINUX := true
 BOARD_VENDOR_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy
+include device/lineage/sepolicy/libion/sepolicy.mk
 
 # Partition information
 TARGET_COPY_OUT_VENDOR := vendor
@@ -38,6 +42,9 @@ BOARD_BOOTIMAGE_PARTITION_SIZE := 67108864
 BOARD_EROFS_PCLUSTER_SIZE := 262144
 BOARD_RECOVERYIMAGE_PARTITION_SIZE := $(BOARD_BOOTIMAGE_PARTITION_SIZE)
 BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := erofs
+# Android 17's aconfigd keeps its flag storage in /metadata/aconfig; without
+# it every flag lookup fails and system_server crashes.
+BOARD_USES_METADATA_PARTITION := true
 BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := erofs
 ifneq ($(TARGET_DEVICE),amogus_doha)
   ## Build product image
diff --git a/device.mk b/device.mk
index 9caa77f..66c72b3 100644
--- a/device.mk
+++ b/device.mk
@@ -19,6 +19,12 @@ PLATFORM_COMMON_PATH := device/motorola/amogus
 AB_OTA_UPDATER := true
 PRODUCT_SHIPPING_API_LEVEL := 29
 
+# This device carries forward a real 4.14 (non-GKI) kernel past the point
+# where AOSP's bundled compatibility matrices still ship 4.14 kernel-config
+# requirements at FCM level 5 (the level PRODUCT_SHIPPING_API_LEVEL=29 maps
+# to) -- checkvintf's kernel/FCM pairing check would otherwise always fail.
+PRODUCT_OTA_ENFORCE_VINTF_KERNEL_REQUIREMENTS := false
+
 AB_OTA_PARTITIONS += \
     boot \
     dtbo \
@@ -74,6 +80,15 @@ TARGET_USES_FPC_FINGERPRINT := true
 PRODUCT_PROPERTY_OVERRIDES += \
     vendor.gatekeeper.disable_spu=true
 
+# Android 17 legacy paths (as LineageOS does for ginkgo, same SoC and
+# 4.14 kernel): libion's real implementation (AOSP made it no-ops, and
+# keymaster/gatekeeper abort with "Cannot open ION device" without it),
+# the gralloc 2/3 mapper (the vendor only serves mapper 3.0), and the
+# displayservice HIDL registration in SurfaceFlinger.
+$(call soong_config_set_bool,libion,legacy_impl,true)
+$(call soong_config_set_bool,libui,legacy_gralloc,true)
+$(call soong_config_set_bool,surfaceflinger,register_displayservice,true)
+
 # HIDL
 PRODUCT_PACKAGES += \
     android.hidl.base@1.0 \
