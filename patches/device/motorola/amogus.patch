diff --git a/BoardConfig.mk b/BoardConfig.mk
index d7cdd2b..27d65c3 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -37,7 +37,10 @@ TARGET_COPY_OUT_VENDOR := vendor
 BOARD_BOOTIMAGE_PARTITION_SIZE := 67108864
 BOARD_EROFS_PCLUSTER_SIZE := 262144
 BOARD_RECOVERYIMAGE_PARTITION_SIZE := $(BOARD_BOOTIMAGE_PARTITION_SIZE)
-BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := erofs
+# system is ext4, not erofs, so addon packages such as MindTheGapps can
+# mount it read-write from Lineage Recovery. LineageOS requires that
+# addon packages listed on its wiki install this way. vendor stays erofs.
+BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := ext4
 BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := erofs
 ifneq ($(TARGET_DEVICE),amogus_doha)
   ## Build product image
diff --git a/device.mk b/device.mk
index 9caa77f..344be9e 100644
--- a/device.mk
+++ b/device.mk
@@ -19,6 +19,12 @@ PLATFORM_COMMON_PATH := device/motorola/amogus
 AB_OTA_UPDATER := true
 PRODUCT_SHIPPING_API_LEVEL := 29
 
+# This device carries forward a real 4.14 (non-GKI) kernel past the point
+# where AOSP's bundled compatibility matrices still ship 4.14 kernel-config
+# requirements at FCM level 5 (the level PRODUCT_SHIPPING_API_LEVEL=29 maps
+# to) -- checkvintf's kernel/FCM pairing check would otherwise always fail.
+PRODUCT_OTA_ENFORCE_VINTF_KERNEL_REQUIREMENTS := false
+
 AB_OTA_PARTITIONS += \
     boot \
     dtbo \
@@ -35,7 +41,6 @@ endif
 AB_OTA_POSTINSTALL_CONFIG := \
     RUN_POSTINSTALL_system=true \
     POSTINSTALL_PATH_system=system/bin/otapreopt_script \
-    FILESYSTEM_TYPE_system=erofs \
     POSTINSTALL_OPTIONAL_system=true
 
 # AAPT
@@ -57,7 +62,9 @@ PRODUCT_PACKAGES += \
     libgui_vendor
 
 # Device Characteristics
-DEVICE_CHARACTERISTICS += fm erofs
+# No erofs: device/motorola/common reads it to pick system's filesystem
+# type for the fstab check and FILESYSTEM_TYPE_system (system is ext4).
+DEVICE_CHARACTERISTICS += fm
 
 # Device Folders
 PRODUCT_PACKAGES += \
