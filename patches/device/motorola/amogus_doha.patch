diff --git a/BoardConfig.mk b/BoardConfig.mk
index 9e00b92..a4ddff2 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -31,9 +31,43 @@ ifneq ($(TARGET_PREBUILT_KERNEL),)
       $(wildcard device/motorola/amogus-kernel/modules/*.ko)
 endif
 
+# Kernel modules to load at boot, from the source-built kernel.
+# LineageOS's kernel.mk always writes vendor/lib/modules/modules.load
+# (vendor/lineage 01eef7f3), empty when this list is empty.
+# That empty file makes init.modprobe.sh skip its "load everything"
+# fallback and leaves vendor_modprobe.sh with nothing to load, so these
+# never loaded: the aw8695 haptics chip had no driver and the vibrator
+# did not work.
+# The FocalTech and Novatek touch drivers are for doha units without the
+# built-in Himax panel; each only binds when its panel is present.
+BOARD_VENDOR_KERNEL_MODULES_LOAD := \
+    aw8624 \
+    aw8695 \
+    sx933x_sar \
+    stmvl53l1 \
+    focaltech_0flash_mmi \
+    focaltech_0flash_mmi_doha \
+    nova_0flash_mmi
+
+# Touch in recovery (doha_android#49). Recovery has no /vendor, so the
+# FocalTech driver (Tianma FT8719 panel) must be in the ramdisk. Since
+# recovery is the boot ramdisk here, a non-empty modules.load in it would
+# also load the driver in first-stage init on every normal boot, before
+# its firmware is reachable. So the load list stays empty and
+# recovery/root/system/etc/init/touch_doha.rc loads it in recovery only.
+# The Himax driver is built in and only needs its firmware (device.mk).
+RECOVERY_KERNEL_MODULES := focaltech_0flash_mmi_doha.ko
+BOARD_VENDOR_SEPOLICY_DIRS += device/motorola/amogus_doha/sepolicy/recovery
+
 # Partitions
 BOARD_VENDORIMAGE_PARTITION_SIZE := 620756992
 BOARD_SYSTEMIMAGE_PARTITION_SIZE := 3238002688
+# ext4 system (doha_android#53): with a fixed partition size the build
+# doesn't size the inode table, and mke2fs' default (one per 16 KiB)
+# gives 194688 inodes for about 8100 used. 16384 keeps 2x headroom and
+# frees about 43 MB for GApps and addon.d restores. Too few inodes fails
+# the build ("Out of inodes?"), not the phone.
+BOARD_SYSTEMIMAGE_EXTFS_INODE_COUNT := 16384
 BOARD_DTBOIMG_PARTITION_SIZE := 8388608
 
 # Recovery
diff --git a/device.mk b/device.mk
index 9051022..ff772d6 100644
--- a/device.mk
+++ b/device.mk
@@ -27,7 +27,8 @@ TARGET_USES_FINGERPRINT_V2_1 := true
 # Overlays
 PRODUCT_PACKAGES += \
     dohaFrameworkOverlay \
-    dohaSystemUIOverlay
+    dohaSystemUIOverlay \
+    dohaApertureOverlay
 
 # Partitions
 TARGET_USES_DYNAMIC_PARTITIONS := false
@@ -44,4 +45,18 @@ PRODUCT_BUILD_PROP_OVERRIDES += \
     BuildDesc="doha_retail-user 10 QPIS30.28-Q3-28-26-4-1-3 f0a9a release-keys" \
     BuildFingerprint=motorola/doha_retail/doha:10/QPIS30.28-Q3-28-26-4-1-3/f0a9a:user/release-keys
 
+# Touch firmware for recovery (doha_android#49). Both doha touch
+# controllers have no flash and get their firmware from the host, but
+# recovery doesn't mount /vendor, and amogus' device-recovery.mk only
+# covers rav and sofia. Tianma FT8719 (FocalTech) and DS HX83112A (Himax).
+PRODUCT_COPY_FILES += \
+    vendor/motorola/amogus_doha/proprietary/vendor/firmware/focaltech-ft8719-a0-0000-doha.bin:$(TARGET_COPY_OUT_RECOVERY)/root/vendor/firmware/focaltech-ft8719-a0-0000-doha.bin \
+    vendor/motorola/amogus_doha/proprietary/vendor/firmware/ds_Himax_firmware.bin:$(TARGET_COPY_OUT_RECOVERY)/root/vendor/firmware/ds_Himax_firmware.bin
+
+# LineageOS 24.0's build no longer copies <device>/recovery/root into
+# recovery (23.2 had that as a build/make patch), so install the init
+# script that loads the FocalTech module explicitly.
+PRODUCT_COPY_FILES += \
+    device/motorola/amogus_doha/recovery/root/system/etc/init/touch_doha.rc:$(TARGET_COPY_OUT_RECOVERY)/root/system/etc/init/touch_doha.rc
+
 $(call inherit-product-if-exists, vendor/motorola/amogus_doha/amogus_doha-vendor.mk)
diff --git a/recovery/root/system/etc/init/touch_doha.rc b/recovery/root/system/etc/init/touch_doha.rc
new file mode 100644
index 0000000..b8642da
--- /dev/null
+++ b/recovery/root/system/etc/init/touch_doha.rc
@@ -0,0 +1,19 @@
+# Recovery only (doha_android#49): touch for units with the Tianma
+# FT8719 panel (FocalTech). Normal boot never reads this file.
+#
+# The driver is a module, and the controller has no flash: it needs its
+# firmware pushed by the host. The driver only learns the firmware file
+# name when something writes it to doreflash; in Android that's
+# /vendor/bin/init.mmi.touch.sh, which recovery doesn't have. doha has
+# one FocalTech panel and one firmware file for it, in recovery's
+# /vendor/firmware (device.mk).
+# The driver drops the last character of what's written (it expects the
+# newline echo adds), hence the \n.
+#
+# On units with the Himax panel the FocalTech device tree node is
+# disabled, so the module doesn't bind, and the Himax driver (built in)
+# has no doreflash: the write just fails.
+on init
+    exec u:r:modprobe:s0 -- /system/bin/modprobe -a -d /lib/modules focaltech_0flash_mmi_doha
+    wait /sys/devices/platform/soc/4a88000.spi/spi_master/spi0/spi0.0/doreflash 2
+    write /sys/devices/platform/soc/4a88000.spi/spi_master/spi0/spi0.0/doreflash focaltech-ft8719-a0-0000-doha.bin\n
