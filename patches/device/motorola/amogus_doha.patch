diff --git a/sepolicy/vendor/mbn_fallback.te b/sepolicy/vendor/mbn_fallback.te
new file mode 100644
index 0000000..f67fe2e
--- /dev/null
+++ b/sepolicy/vendor/mbn_fallback.te
@@ -0,0 +1,10 @@
+# doha_android#61: mbn_fallback selects the modem's carrier MBN over QMI
+# PDC (QRTR) when the modem fell back to EMEA_APAC_SUPER.
+type mbn_fallback, domain;
+type mbn_fallback_exec, exec_type, vendor_file_type, file_type;
+init_daemon_domain(mbn_fallback)
+
+allow mbn_fallback self:qipcrtr_socket create_socket_perms_no_ioctl;
+
+# gsm.sim.operator.numeric: the SIM's home PLMN per slot.
+get_prop(mbn_fallback, telephony_status_prop)
